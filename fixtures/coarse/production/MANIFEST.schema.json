{
  "$defs": {
    "ProductionArtifact": {
      "additionalProperties": false,
      "description": "One rights-cleared production export recorded in the MANIFEST.",
      "properties": {
        "byte_size": {
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_path": {
          "description": "Path relative to the production fixture root (e.g. reviews/export-01.json).",
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "rights_record_id": {
          "minLength": 1,
          "title": "Rights Record Id",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "content_sha256",
        "byte_size",
        "rights_record_id"
      ],
      "title": "ProductionArtifact",
      "type": "object"
    },
    "ProductionIntakeStatus": {
      "enum": [
        "pending",
        "blocked",
        "ready"
      ],
      "title": "ProductionIntakeStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Schema for ``fixtures/*/production/MANIFEST.json``.",
  "properties": {
    "adapter": {
      "pattern": "^(coarse|openreviewer)$",
      "title": "Adapter",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ProductionArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason"
    },
    "manifest_version": {
      "default": "0.1",
      "title": "Manifest Version",
      "type": "string"
    },
    "performance_claims_authorized": {
      "default": false,
      "title": "Performance Claims Authorized",
      "type": "boolean"
    },
    "retrieval_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval Date"
    },
    "rights_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Rights Record Ids",
      "type": "array"
    },
    "sample_contract_forbidden": {
      "default": true,
      "title": "Sample Contract Forbidden",
      "type": "boolean"
    },
    "source": {
      "pattern": "^production$",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ProductionIntakeStatus"
    },
    "upstream_commit_or_config": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upstream Commit Or Config"
    },
    "upstream_repository": {
      "minLength": 1,
      "title": "Upstream Repository",
      "type": "string"
    }
  },
  "required": [
    "adapter",
    "source",
    "status",
    "upstream_repository"
  ],
  "title": "ProductionManifest",
  "type": "object"
}
