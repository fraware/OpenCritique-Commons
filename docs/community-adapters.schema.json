{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/OpenCritique-Commons/docs/community-adapters.schema.json",
  "title": "OpenCritiqueCommunityAdaptersRegistry",
  "description": "Machine-readable registry of community / in-tree adapters. Listing means interchange compatibility interest, not endorsement of reviewer quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "schema_freeze_release",
    "performance_claims_authorized",
    "adapters"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "0.1"
    },
    "schema_freeze_release": {
      "type": "string",
      "const": "0.5.0a1",
      "description": "Must match SCHEMA_FREEZE_RELEASE; interchange identity, not package version."
    },
    "performance_claims_authorized": {
      "type": "boolean",
      "const": false,
      "description": "Registry-level claim lock; must remain false until §12 / v0.9 gates."
    },
    "notes": {
      "type": "string"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AdapterEntry"
      }
    }
  },
  "$defs": {
    "AdapterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "maintainer",
        "repo_url",
        "status",
        "evidence_class",
        "claims",
        "docs"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "repo_url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "status": {
          "type": "string",
          "enum": ["in-tree", "external", "planned"]
        },
        "evidence_class": {
          "type": "string",
          "enum": ["sample", "private_live", "production"],
          "description": "Honest evidence posture for what is publicly or privately available."
        },
        "claims": {
          "type": "boolean",
          "const": false,
          "description": "Always false until claim-authorization gates are met."
        },
        "docs": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative or absolute URL to authoring / adapter notes."
        },
        "sample_contract_id": {
          "type": ["string", "null"],
          "description": "Pinned sample adapter contract id when status is in-tree sample."
        },
        "upstream_contract_version": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
