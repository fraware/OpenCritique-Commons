{
  "$defs": {
    "AttestationRecordStatus": {
      "description": "Issuer-declared status of the attestation payload (not crypto verify).",
      "enum": [
        "blocked",
        "pending",
        "attested"
      ],
      "title": "AttestationRecordStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Attests rights-cleared natural corpus subjects (ledger case bindings).",
  "properties": {
    "attestation_id": {
      "minLength": 1,
      "title": "Attestation Id",
      "type": "string"
    },
    "attestation_kind": {
      "const": "natural_corpus",
      "default": "natural_corpus",
      "title": "Attestation Kind",
      "type": "string"
    },
    "authority_id": {
      "minLength": 1,
      "title": "Authority Id",
      "type": "string"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "ledger_path": {
      "minLength": 1,
      "title": "Ledger Path",
      "type": "string"
    },
    "natural_case_count": {
      "default": 0,
      "minimum": 0,
      "title": "Natural Case Count",
      "type": "integer"
    },
    "natural_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Natural Case Ids",
      "type": "array"
    },
    "not_after": {
      "format": "date-time",
      "title": "Not After",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "predecessor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Id"
    },
    "subject_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Named subject digests (sha256 hex) bound by this attestation.",
      "title": "Subject Hashes",
      "type": "object"
    },
    "verification_status": {
      "$ref": "#/$defs/AttestationRecordStatus",
      "default": "blocked"
    }
  },
  "required": [
    "attestation_id",
    "authority_id",
    "issued_at",
    "not_after",
    "ledger_path"
  ],
  "title": "NaturalCorpusAttestation",
  "type": "object"
}
