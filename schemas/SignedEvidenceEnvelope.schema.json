          "default": null,
          "title": "Blocked Reason"
        },
        "independent_evaluation": {
          "default": true,
          "title": "Independent Evaluation",
          "type": "boolean"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "not_after": {
          "format": "date-time",
          "title": "Not After",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "predecessor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Id"
        },
        "subject_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Named subject digests (sha256 hex) bound by this attestation.",
          "title": "Subject Hashes",
          "type": "object"
        },
        "verification_status": {
          "$ref": "#/$defs/AttestationRecordStatus",
          "default": "blocked"
        }
      },
      "required": [
        "attestation_id",
        "authority_id",
        "issued_at",
        "not_after"
      ],
      "title": "IndependentEvaluationAttestation",
      "type": "object"
    },
    "MatcherAuditCompletionAttestation": {
      "additionalProperties": false,
