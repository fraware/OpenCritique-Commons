        "authority_id",
        "issued_at",
        "not_after",
        "ledger_path"
      ],
      "title": "NaturalCorpusAttestation",
      "type": "object"
    },
    "ReviewerExportAuthenticityAttestation": {
      "additionalProperties": false,
      "description": "Attests authentic production reviewer-export packages.",
      "properties": {
        "adapter": {
          "enum": [
            "coarse",
            "openreviewer"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "artifact_content_hashes": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Content Hashes",
          "type": "array"
        },
        "attestation_id": {
          "minLength": 1,
          "title": "Attestation Id",
          "type": "string"
        },
        "attestation_kind": {
          "const": "reviewer_export_authenticity",
          "default": "reviewer_export_authenticity",
          "title": "Attestation Kind",
          "type": "string"
        },
        "authority_id": {
          "minLength": 1,
          "title": "Authority Id",
          "type": "string"
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocked Reason"
        },
        "export_count": {
          "default": 0,
          "minimum": 0,
          "title": "Export Count",
          "type": "integer"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "manifest_path": {
          "minLength": 1,
          "title": "Manifest Path",
