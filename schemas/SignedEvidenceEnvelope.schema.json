  },
  "additionalProperties": false,
  "description": "Ed25519-signed scientific evidence attestation envelope.",
  "properties": {
    "algorithm": {
      "const": "Ed25519",
      "default": "Ed25519",
      "title": "Algorithm",
      "type": "string"
    },
    "attestation": {
      "discriminator": {
        "mapping": {
          "expert_staffing": "#/$defs/ExpertStaffingAttestation",
          "holdout_custody": "#/$defs/HoldoutCustodyAttestation",
          "independent_evaluation": "#/$defs/IndependentEvaluationAttestation",
          "matcher_audit_completion": "#/$defs/MatcherAuditCompletionAttestation",
          "natural_corpus": "#/$defs/NaturalCorpusAttestation",
          "reviewer_export_authenticity": "#/$defs/ReviewerExportAuthenticityAttestation"
        },
        "propertyName": "attestation_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NaturalCorpusAttestation"
        },
        {
          "$ref": "#/$defs/ReviewerExportAuthenticityAttestation"
        },
        {
          "$ref": "#/$defs/ExpertStaffingAttestation"
        },
        {
          "$ref": "#/$defs/MatcherAuditCompletionAttestation"
        },
        {
          "$ref": "#/$defs/HoldoutCustodyAttestation"
        },
        {
          "$ref": "#/$defs/IndependentEvaluationAttestation"
        }
      ],
      "title": "Attestation"
    },
    "envelope_version": {
      "default": "0.1",
      "title": "Envelope Version",
      "type": "string"
    },
    "key_id": {
      "minLength": 1,
      "title": "Key Id",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "signature": {
      "description": "Ed25519 signature (base64)",
      "minLength": 1,
      "title": "Signature",
      "type": "string"
    },
    "signed_at": {
      "format": "date-time",
      "title": "Signed At",
      "type": "string"
    }
  },
  "required": [
    "attestation",
    "payload_sha256",
    "signature",
    "key_id",
    "signed_at"
  ],
  "title": "SignedEvidenceEnvelope",
  "type": "object"
}
