        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "ledger_path": {
          "minLength": 1,
          "title": "Ledger Path",
          "type": "string"
        },
        "natural_case_count": {
          "default": 0,
          "minimum": 0,
          "title": "Natural Case Count",
          "type": "integer"
        },
        "natural_case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Natural Case Ids",
          "type": "array"
        },
        "not_after": {
          "format": "date-time",
          "title": "Not After",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "predecessor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Id"
        },
        "subject_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Named subject digests (sha256 hex) bound by this attestation.",
          "title": "Subject Hashes",
          "type": "object"
        },
        "verification_status": {
          "$ref": "#/$defs/AttestationRecordStatus",
