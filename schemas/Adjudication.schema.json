{
  "$defs": {
    "ActorReference": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "actor_id",
        "actor_type"
      ],
      "title": "ActorReference",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "system",
        "tool",
        "organization"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ConflictDeclaration": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "status": {
          "enum": [
            "none",
            "disclosed",
            "disqualifying"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "ConflictDeclaration",
      "type": "object"
    },
    "FollowupRequest": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "request_type": {
          "title": "Request Type",
          "type": "string"
        }
      },
      "required": [
        "request_type",
        "description"
      ],
      "title": "FollowupRequest",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "moderate",
        "minor",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValidityDecision": {
      "enum": [
        "confirmed",
        "qualified",
        "rejected",
        "unresolved"
      ],
      "title": "ValidityDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjudication_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Adjudication Id",
      "type": "string"
    },
    "adjudication_round": {
      "minimum": 1,
      "title": "Adjudication Round",
      "type": "integer"
    },
    "adjudicator_id": {
      "title": "Adjudicator Id",
      "type": "string"
    },
    "anchors_reviewed": {
      "title": "Anchors Reviewed",
      "type": "boolean"
    },
    "blinded_fields": {
      "items": {
        "type": "string"
      },
      "title": "Blinded Fields",
      "type": "array"
    },
    "concern_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Concern Id",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "conflict_declaration": {
      "$ref": "#/$defs/ConflictDeclaration"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "counterposition_assessment": {
      "title": "Counterposition Assessment",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorReference"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "reasoning": {
      "minLength": 1,
      "title": "Reasoning",
      "type": "string"
    },
    "requested_followup": {
      "items": {
        "$ref": "#/$defs/FollowupRequest"
      },
      "title": "Requested Followup",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "validity": {
      "$ref": "#/$defs/ValidityDecision"
    }
  },
  "required": [
    "id",
    "created_by",
    "content_hash",
    "adjudication_id",
    "concern_id",
    "adjudicator_id",
    "adjudication_round",
    "blinded_fields",
    "conflict_declaration",
    "validity",
    "severity",
    "confidence",
    "reasoning",
    "evidence_ids",
    "counterposition_assessment",
    "anchors_reviewed"
  ],
  "title": "Adjudication",
  "type": "object"
}
