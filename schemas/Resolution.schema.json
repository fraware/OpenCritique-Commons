{
  "$defs": {
    "ActorReference": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "actor_id",
        "actor_type"
      ],
      "title": "ActorReference",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "system",
        "tool",
        "organization"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ResolutionType": {
      "enum": [
        "manuscript_revised",
        "explanation_added",
        "analysis_rerun",
        "concern_withdrawn",
        "disagreement_documented",
        "external_correction",
        "unresolved"
      ],
      "title": "ResolutionType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "concern_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Concern Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorReference"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "from_version_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "From Version Id",
      "type": "string"
    },
    "id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "resolution_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Resolution Id",
      "type": "string"
    },
    "resolution_type": {
      "$ref": "#/$defs/ResolutionType"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "to_version_id": {
      "anyOf": [
        {
          "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "To Version Id"
    },
    "verification_evidence_ids": {
      "items": {
        "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
        "type": "string"
      },
      "title": "Verification Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "created_by",
    "content_hash",
    "resolution_id",
    "concern_id",
    "resolution_type",
    "description",
    "from_version_id"
  ],
  "title": "Resolution",
  "type": "object"
}
