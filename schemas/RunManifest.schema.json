{
  "$defs": {
    "ActorReference": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "actor_id",
        "actor_type"
      ],
      "title": "ActorReference",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "system",
        "tool",
        "organization"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "RunCost": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "currency",
        "total"
      ],
      "title": "RunCost",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Commit"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "cost": {
      "$ref": "#/$defs/RunCost"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorReference"
    },
    "id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "input_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "array"
    },
    "latency_seconds": {
      "minimum": 0,
      "title": "Latency Seconds",
      "type": "number"
    },
    "model_identifiers": {
      "items": {
        "type": "string"
      },
      "title": "Model Identifiers",
      "type": "array"
    },
    "output_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "prompt_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Prompt Hashes",
      "type": "array"
    },
    "randomness_configuration": {
      "additionalProperties": true,
      "title": "Randomness Configuration",
      "type": "object"
    },
    "retrieval_snapshot_ids": {
      "items": {
        "type": "string"
      },
      "title": "Retrieval Snapshot Ids",
      "type": "array"
    },
    "run_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "system_id": {
      "title": "System Id",
      "type": "string"
    },
    "system_version": {
      "title": "System Version",
      "type": "string"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    }
  },
  "required": [
    "id",
    "created_by",
    "content_hash",
    "run_id",
    "system_id",
    "system_version",
    "model_identifiers",
    "prompt_hashes",
    "tool_versions",
    "input_hashes",
    "retrieval_snapshot_ids",
    "configuration",
    "started_at",
    "completed_at",
    "cost",
    "latency_seconds",
    "randomness_configuration",
    "output_hash"
  ],
  "title": "RunManifest",
  "type": "object"
}
