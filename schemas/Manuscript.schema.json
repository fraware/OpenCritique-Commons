{
  "$defs": {
    "ActorReference": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "actor_id",
        "actor_type"
      ],
      "title": "ActorReference",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "system",
        "tool",
        "organization"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "RightsClassification": {
      "enum": [
        "public",
        "contributed",
        "confidential",
        "restricted"
      ],
      "title": "RightsClassification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "consent_policy_id": {
      "title": "Consent Policy Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorReference"
    },
    "current_version_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Current Version Id",
      "type": "string"
    },
    "id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "manuscript_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Manuscript Id",
      "type": "string"
    },
    "rights_classification": {
      "$ref": "#/$defs/RightsClassification"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Title"
    }
  },
  "required": [
    "id",
    "created_by",
    "content_hash",
    "manuscript_id",
    "title",
    "rights_classification",
    "consent_policy_id",
    "current_version_id"
  ],
  "title": "Manuscript",
  "type": "object"
}
