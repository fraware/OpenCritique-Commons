{
  "$defs": {
    "AttestationRecordStatus": {
      "description": "Issuer-declared status of the attestation payload (not crypto verify).",
      "enum": [
        "blocked",
        "pending",
        "attested"
      ],
      "title": "AttestationRecordStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Attests qualified independent adjudicators per domain profile.",
  "properties": {
    "attestation_id": {
      "minLength": 1,
      "title": "Attestation Id",
      "type": "string"
    },
    "attestation_kind": {
      "const": "expert_staffing",
      "default": "expert_staffing",
      "title": "Attestation Kind",
      "type": "string"
    },
    "authority_id": {
      "minLength": 1,
      "title": "Authority Id",
      "type": "string"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason"
    },
    "domain_profiles": {
      "items": {
        "type": "string"
      },
      "title": "Domain Profiles",
      "type": "array"
    },
    "independent_adjudicator_ids": {
      "items": {
        "type": "string"
      },
      "title": "Independent Adjudicator Ids",
      "type": "array"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "min_adjudicators_per_domain": {
      "default": 2,
      "minimum": 1,
      "title": "Min Adjudicators Per Domain",
      "type": "integer"
    },
    "min_domains_required": {
      "default": 2,
      "minimum": 2,
      "title": "Min Domains Required",
      "type": "integer"
    },
    "not_after": {
      "format": "date-time",
      "title": "Not After",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "predecessor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Id"
    },
    "roster_path": {
      "minLength": 1,
      "title": "Roster Path",
      "type": "string"
    },
    "subject_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Named subject digests (sha256 hex) bound by this attestation.",
      "title": "Subject Hashes",
      "type": "object"
    },
    "verification_status": {
      "$ref": "#/$defs/AttestationRecordStatus",
      "default": "blocked"
    }
  },
  "required": [
    "attestation_id",
    "authority_id",
    "issued_at",
    "not_after",
    "roster_path"
  ],
  "title": "ExpertStaffingAttestation",
  "type": "object"
}
