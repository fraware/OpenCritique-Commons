{
  "$defs": {
    "AnchorResolution": {
      "additionalProperties": false,
      "properties": {
        "reference_anchor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Reference Anchor Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/AnchorResolutionStatus"
        },
        "submitted_index": {
          "title": "Submitted Index",
          "type": "integer"
        }
      },
      "required": [
        "submitted_index",
        "status"
      ],
      "title": "AnchorResolution",
      "type": "object"
    },
    "AnchorResolutionStatus": {
      "enum": [
        "exact",
        "normalized",
        "object_label",
        "page_only",
        "ambiguous",
        "unresolved"
      ],
      "title": "AnchorResolutionStatus",
      "type": "string"
    },
    "BenchmarkCaseRef": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "case_version": {
          "title": "Case Version",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_version",
        "path"
      ],
      "title": "BenchmarkCaseRef",
      "type": "object"
    },
    "BenchmarkEvidenceClass": {
      "enum": [
        "conformance",
        "synthetic_scientific",
        "expert_natural",
        "live_private"
      ],
      "title": "BenchmarkEvidenceClass",
      "type": "string"
    },
    "BenchmarkManifest": {
      "additionalProperties": false,
      "properties": {
        "benchmark_id": {
          "title": "Benchmark Id",
          "type": "string"
        },
        "case_set_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Set Hash",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/BenchmarkCaseRef"
          },
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "comparative_authorization": {
          "default": false,
          "title": "Comparative Authorization",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "domain_profiles": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Domain Profiles",
          "type": "array"
        },
        "domain_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Scope"
        },
        "evidence_class": {
          "$ref": "#/$defs/BenchmarkEvidenceClass"
        },
        "expert_adjudicated": {
          "default": false,
          "title": "Expert Adjudicated",
          "type": "boolean"
        },
        "frozen_scoring_policy": {
          "default": false,
          "title": "Frozen Scoring Policy",
          "type": "boolean"
        },
        "independent_evaluation": {
          "default": false,
          "title": "Independent Evaluation",
          "type": "boolean"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "matcher_audit_complete": {
          "default": false,
          "title": "Matcher Audit Complete",
          "type": "boolean"
        },
        "minimum_public_claim_cases": {
          "default": 40,
          "minimum": 1,
          "title": "Minimum Public Claim Cases",
          "type": "integer"
        },
        "protected_holdout": {
          "default": false,
          "title": "Protected Holdout",
          "type": "boolean"
        },
        "reference_completeness": {
          "$ref": "#/$defs/ReferenceCompleteness"
        },
        "rights_cleared_cases": {
          "default": false,
          "title": "Rights Cleared Cases",
          "type": "boolean"
        },
        "signed_authorization_manifest_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed Authorization Manifest Digest"
        },
        "signed_authorization_manifest_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed Authorization Manifest Path"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "use_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use Scope"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "benchmark_id",
        "version",
        "title",
        "description",
        "evidence_class",
        "reference_completeness",
        "domain_profiles",
        "cases",
        "license",
        "case_set_hash",
        "created_at"
      ],
      "title": "BenchmarkManifest",
      "type": "object"
    },
    "ByokConfig": {
      "additionalProperties": false,
      "description": "Bring-your-own-key deployment descriptor (no credential retention).",
      "properties": {
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "retain_credentials": {
          "const": false,
          "default": false,
          "title": "Retain Credentials",
          "type": "boolean"
        }
      },
      "required": [
        "provider_id"
      ],
      "title": "ByokConfig",
      "type": "object"
    },
    "CaseEvaluation": {
      "additionalProperties": false,
      "properties": {
        "abstained": {
          "title": "Abstained",
          "type": "boolean"
        },
        "anchor_resolutions": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/AnchorResolution"
            },
            "type": "array"
          },
          "title": "Anchor Resolutions",
          "type": "object"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "case_version": {
          "title": "Case Version",
          "type": "string"
        },
        "eligible_reference_count": {
          "title": "Eligible Reference Count",
          "type": "integer"
        },
        "failure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure"
        },
        "matches": {
          "items": {
            "$ref": "#/$defs/ConcernMatch"
          },
          "title": "Matches",
          "type": "array"
        },
        "missed_reference_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missed Reference Ids",
          "type": "array"
        },
        "submitted_count": {
          "title": "Submitted Count",
          "type": "integer"
        },
        "unmatched_submitted_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unmatched Submitted Ids",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "case_version",
        "submitted_count",
        "eligible_reference_count",
        "matches",
        "unmatched_submitted_ids",
        "missed_reference_ids",
        "anchor_resolutions",
        "abstained",
        "failure"
      ],
      "title": "CaseEvaluation",
      "type": "object"
    },
    "ClaimAuthorization": {
      "additionalProperties": false,
      "description": "Structured claim authorization; prefer ``claim_scope`` over the bool.\n\nPublic scopes are a derived view of a successfully verified\n``SignedClaimAuthorizationEnvelope``. Digest strings alone do not authorize.",
      "properties": {
        "authorization_verified": {
          "default": false,
          "title": "Authorization Verified",
          "type": "boolean"
        },
        "claim_scope": {
          "$ref": "#/$defs/ClaimScope"
        },
        "domain_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Scope"
        },
        "expert_natural_evidence": {
          "default": false,
          "title": "Expert Natural Evidence",
          "type": "boolean"
        },
        "frozen_scoring_policy": {
          "default": false,
          "title": "Frozen Scoring Policy",
          "type": "boolean"
        },
        "independent_evaluation": {
          "default": false,
          "title": "Independent Evaluation",
          "type": "boolean"
        },
        "matcher_audit_complete": {
          "default": false,
          "title": "Matcher Audit Complete",
          "type": "boolean"
        },
        "protected_holdout": {
          "default": false,
          "title": "Protected Holdout",
          "type": "boolean"
        },
        "rights_cleared_cases": {
          "default": false,
          "title": "Rights Cleared Cases",
          "type": "boolean"
        },
        "signed_authorization_manifest_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed Authorization Manifest Digest"
        },
        "signed_authorization_manifest_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed Authorization Manifest Path"
        },
        "use_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use Scope"
        },
        "verification_report_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Report Digest"
        }
      },
      "required": [
        "claim_scope"
      ],
      "title": "ClaimAuthorization",
      "type": "object"
    },
    "ClaimAuthorizationDecision": {
      "additionalProperties": false,
      "description": "Immutable claim-authorization decision payload (signed inside an envelope).",
      "properties": {
        "authority_id": {
          "minLength": 1,
          "title": "Authority Id",
          "type": "string"
        },
        "authorized_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Authorized Metrics",
          "type": "array"
        },
        "benchmark_id": {
          "title": "Benchmark Id",
          "type": "string"
        },
        "benchmark_manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Benchmark Manifest Hash",
          "type": "string"
        },
        "benchmark_version": {
          "title": "Benchmark Version",
          "type": "string"
        },
        "case_set_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Set Hash",
          "type": "string"
        },
        "claim_scope": {
          "$ref": "#/$defs/ClaimScope"
        },
        "domain_scope": {
          "minLength": 1,
          "title": "Domain Scope",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "matcher_config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Matcher Config Hash",
          "type": "string"
        },
        "matcher_version": {
          "title": "Matcher Version",
          "type": "string"
        },
        "not_after": {
          "format": "date-time",
          "title": "Not After",
          "type": "string"
        },
        "predecessor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Id"
        },
        "scoring_policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scoring Policy Hash",
          "type": "string"
        },
        "use_scope": {
          "minLength": 1,
          "title": "Use Scope",
          "type": "string"
        }
      },
      "required": [
        "claim_scope",
        "benchmark_id",
        "benchmark_version",
        "case_set_hash",
        "benchmark_manifest_hash",
        "scoring_policy_hash",
        "matcher_version",
        "matcher_config_hash",
        "domain_scope",
        "use_scope",
        "issued_at",
        "not_after",
        "authority_id"
      ],
      "title": "ClaimAuthorizationDecision",
      "type": "object"
    },
    "ClaimScope": {
      "description": "Signed authorization scope for scientific performance language.",
      "enum": [
        "none",
        "private_method_report",
        "public_domain_bounded",
        "public_comparative"
      ],
      "title": "ClaimScope",
      "type": "string"
    },
    "ConcernMatch": {
      "additionalProperties": false,
      "properties": {
        "anchor_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor Score",
          "type": "number"
        },
        "lexical_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Lexical Score",
          "type": "number"
        },
        "reference_concern_id": {
          "title": "Reference Concern Id",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "submitted_local_id": {
          "title": "Submitted Local Id",
          "type": "string"
        },
        "type_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Type Score",
          "type": "number"
        }
      },
      "required": [
        "submitted_local_id",
        "reference_concern_id",
        "score",
        "anchor_score",
        "type_score",
        "lexical_score"
      ],
      "title": "ConcernMatch",
      "type": "object"
    },
    "EvaluationMetrics": {
      "additionalProperties": false,
      "properties": {
        "anchor_resolution_rate": {
          "$ref": "#/$defs/MetricValue"
        },
        "cases_abstained": {
          "title": "Cases Abstained",
          "type": "integer"
        },
        "cases_completed": {
          "title": "Cases Completed",
          "type": "integer"
        },
        "cases_failed": {
          "title": "Cases Failed",
          "type": "integer"
        },
        "cases_total": {
          "title": "Cases Total",
          "type": "integer"
        },
        "eligible_reference_concerns": {
          "title": "Eligible Reference Concerns",
          "type": "integer"
        },
        "false_critical_per_manuscript": {
          "$ref": "#/$defs/MetricValue"
        },
        "matched_concerns": {
          "title": "Matched Concerns",
          "type": "integer"
        },
        "missed_reference": {
          "title": "Missed Reference",
          "type": "integer"
        },
        "novel_candidates_pending_adjudication": {
          "title": "Novel Candidates Pending Adjudication",
          "type": "integer"
        },
        "precision": {
          "$ref": "#/$defs/MetricValue"
        },
        "recall": {
          "$ref": "#/$defs/MetricValue"
        },
        "reference_match_brier_score": {
          "$ref": "#/$defs/MetricValue"
        },
        "severity_weighted_precision": {
          "$ref": "#/$defs/MetricValue"
        },
        "severity_weighted_recall": {
          "$ref": "#/$defs/MetricValue"
        },
        "submitted_concerns": {
          "title": "Submitted Concerns",
          "type": "integer"
        },
        "unmatched_submitted": {
          "title": "Unmatched Submitted",
          "type": "integer"
        }
      },
      "required": [
        "cases_total",
        "cases_completed",
        "cases_abstained",
        "cases_failed",
        "submitted_concerns",
        "eligible_reference_concerns",
        "matched_concerns",
        "unmatched_submitted",
        "missed_reference",
        "anchor_resolution_rate",
        "precision",
        "recall",
        "severity_weighted_precision",
        "severity_weighted_recall",
        "false_critical_per_manuscript",
        "reference_match_brier_score",
        "novel_candidates_pending_adjudication"
      ],
      "title": "EvaluationMetrics",
      "type": "object"
    },
    "EvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "$ref": "#/$defs/BenchmarkManifest"
        },
        "case_evaluations": {
          "items": {
            "$ref": "#/$defs/CaseEvaluation"
          },
          "title": "Case Evaluations",
          "type": "array"
        },
        "claim_authorization": {
          "$ref": "#/$defs/ClaimAuthorization"
        },
        "claim_authorization_envelope": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignedClaimAuthorizationEnvelope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "claim_boundary": {
          "title": "Claim Boundary",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "matcher_config": {
          "$ref": "#/$defs/MatcherConfig"
        },
        "matcher_version": {
          "title": "Matcher Version",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/EvaluationMetrics"
        },
        "performance_claim_authorized": {
          "default": false,
          "title": "Performance Claim Authorized",
          "type": "boolean"
        },
        "predecessor_result_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Result Id"
        },
        "result_id": {
          "title": "Result Id",
          "type": "string"
        },
        "scoring_policy_version": {
          "default": "scoring-policy-v0.1",
          "title": "Scoring Policy Version",
          "type": "string"
        },
        "submission_id": {
          "title": "Submission Id",
          "type": "string"
        },
        "system": {
          "$ref": "#/$defs/SystemManifest"
        }
      },
      "required": [
        "result_id",
        "benchmark",
        "system",
        "submission_id",
        "matcher_version",
        "case_evaluations",
        "metrics",
        "claim_boundary"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "MatcherConfig": {
      "additionalProperties": false,
      "properties": {
        "anchor_weight": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor Weight",
          "type": "number"
        },
        "config_id": {
          "default": "default-v0.2",
          "title": "Config Id",
          "type": "string"
        },
        "lexical_weight": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Lexical Weight",
          "type": "number"
        },
        "threshold": {
          "default": 0.55,
          "maximum": 1,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "type_weight": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Type Weight",
          "type": "number"
        }
      },
      "title": "MatcherConfig",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "withheld_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Withheld Reason"
        }
      },
      "required": [
        "value"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "PublicScorecard": {
      "additionalProperties": false,
      "properties": {
        "disclosure": {
          "title": "Disclosure",
          "type": "string"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "immutable": {
          "default": true,
          "title": "Immutable",
          "type": "boolean"
        },
        "predecessor_scorecard_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Scorecard Hash"
        },
        "predecessor_scorecard_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Scorecard Id"
        },
        "reference_set_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Set Hash"
        },
        "result": {
          "$ref": "#/$defs/EvaluationResult"
        },
        "scorecard_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scorecard Id"
        },
        "scorecard_version": {
          "default": "0.1",
          "title": "Scorecard Version",
          "type": "string"
        },
        "scoring_policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scoring Policy Version"
        }
      },
      "required": [
