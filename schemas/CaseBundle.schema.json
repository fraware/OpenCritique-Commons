        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorReference"
        },
        "dependency_claim_ids": {
          "items": {
            "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
