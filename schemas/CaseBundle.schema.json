        "id": {
          "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "manuscript_version_id": {
          "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
          "title": "Manuscript Version Id",
          "type": "string"
        },
        "reconstruction_notes": {
          "title": "Reconstruction Notes",
          "type": "string"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "created_by",
        "content_hash",
        "claim_id",
        "manuscript_version_id",
        "statement",
        "claim_type",
        "explicitness",
        "scope",
        "anchor_ids",
        "reconstruction_notes"
