{
  "$defs": {
    "ActorReference": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "actor_id",
        "actor_type"
      ],
      "title": "ActorReference",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "system",
        "tool",
        "organization"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "media_type",
        "byte_size"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "EvidenceDirection": {
      "enum": [
        "concern",
        "manuscript_defense",
        "uncertainty",
        "procedural_fact"
      ],
      "title": "EvidenceDirection",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "manuscript_text",
        "page_render",
        "external_source",
        "deterministic_computation",
        "statistical_analysis",
        "symbolic_analysis",
        "formal_tool_output",
        "code_execution",
        "expert_reasoning",
        "author_response",
        "procedural"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "ReproducibilityStatus": {
      "enum": [
        "reproducible",
        "partially_reproducible",
        "non_reproducible",
        "judgment_based"
      ],
      "title": "ReproducibilityStatus",
      "type": "string"
    },
    "ToolManifest": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "additionalProperties": true,
          "title": "Configuration",
          "type": "object"
        },
        "output_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version"
      ],
      "title": "ToolManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anchor_ids": {
      "items": {
        "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
        "type": "string"
      },
      "title": "Anchor Ids",
      "type": "array"
    },
    "artifact_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "concern_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Concern Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorReference"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "independence_group": {
      "title": "Independence Group",
      "type": "string"
    },
    "limitations": {
      "title": "Limitations",
      "type": "string"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/ActorReference"
    },
    "reproducibility_status": {
      "$ref": "#/$defs/ReproducibilityStatus"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supports": {
      "$ref": "#/$defs/EvidenceDirection"
    },
    "tool_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "created_by",
    "content_hash",
    "evidence_id",
    "concern_id",
    "evidence_type",
    "supports",
    "description",
    "method",
    "producer",
    "reproducibility_status",
    "limitations",
    "independence_group"
  ],
  "title": "EvidenceItem",
  "type": "object"
}
