{
  "$defs": {
    "ActorReference": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "actor_id",
        "actor_type"
      ],
      "title": "ActorReference",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "system",
        "tool",
        "organization"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "media_type",
        "byte_size"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "IngestionMetadata": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "page_indexing": {
          "const": "one-indexed",
          "default": "one-indexed",
          "title": "Page Indexing",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "method",
        "tool",
        "tool_version"
      ],
      "title": "IngestionMetadata",
      "type": "object"
    },
    "SourceFormat": {
      "enum": [
        "pdf",
        "tex",
        "docx",
        "markdown",
        "html",
        "other"
      ],
      "title": "SourceFormat",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorReference"
    },
    "domain_profile": {
      "title": "Domain Profile",
      "type": "string"
    },
    "extracted_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "ingestion_metadata": {
      "$ref": "#/$defs/IngestionMetadata"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "manuscript_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Manuscript Id",
      "type": "string"
    },
    "page_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Count"
    },
    "previous_version_id": {
      "anyOf": [
        {
          "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Version Id"
    },
    "rendered_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_artifact": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "source_format": {
      "$ref": "#/$defs/SourceFormat"
    },
    "version_id": {
      "pattern": "^oc[a-z]*_[A-Za-z0-9._-]+$",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_by",
    "content_hash",
    "version_id",
    "manuscript_id",
    "source_format",
    "source_artifact",
    "language",
    "domain_profile",
    "ingestion_metadata"
  ],
  "title": "ManuscriptVersion",
  "type": "object"
}
