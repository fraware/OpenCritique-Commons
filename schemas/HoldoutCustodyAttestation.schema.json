{
  "$defs": {
    "AttestationRecordStatus": {
      "description": "Issuer-declared status of the attestation payload (not crypto verify).",
      "enum": [
        "blocked",
        "pending",
        "attested"
      ],
      "title": "AttestationRecordStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Holdout custody attestation signed over manifest + access-log head.\n\nWhen ``verification_status=attested``, the payload must bind\n``holdout_manifest_hash`` and ``access_log_head_hash`` (also mirrored in\n``subject_hashes``), freeze time, custodian, opaque locator, and declare no\ncontamination. Scientific gate #7 additionally requires\n``natural_case_count`` >= 40 inside this attested holdout set - ledger\n``IMPORTED`` counts alone do not satisfy the gate.",
  "properties": {
    "access_log_head_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Log Head Hash"
    },
    "attestation_id": {
      "minLength": 1,
      "title": "Attestation Id",
      "type": "string"
    },
    "attestation_kind": {
      "const": "holdout_custody",
      "default": "holdout_custody",
      "title": "Attestation Kind",
      "type": "string"
    },
    "authority_id": {
      "minLength": 1,
      "title": "Authority Id",
      "type": "string"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason"
    },
    "contamination_declared": {
      "default": false,
      "title": "Contamination Declared",
      "type": "boolean"
    },
    "contamination_details": {
      "default": "",
      "title": "Contamination Details",
      "type": "string"
    },
    "custodian_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Custodian Id"
    },
    "developer_exclusion_list": {
      "items": {
        "type": "string"
      },
      "title": "Developer Exclusion List",
      "type": "array"
    },
    "freeze_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freeze Time"
    },
    "holdout_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holdout Id"
    },
    "holdout_manifest_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holdout Manifest Hash"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "natural_case_count": {
      "default": 0,
      "minimum": 0,
      "title": "Natural Case Count",
      "type": "integer"
    },
    "not_after": {
      "format": "date-time",
      "title": "Not After",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "predecessor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Id"
    },
    "private_locator_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Private Locator Ref"
    },
    "refresh_policy": {
      "default": "",
      "title": "Refresh Policy",
      "type": "string"
    },
    "retirement_policy": {
      "default": "",
      "title": "Retirement Policy",
      "type": "string"
    },
    "subject_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Named subject digests (sha256 hex) bound by this attestation.",
      "title": "Subject Hashes",
      "type": "object"
    },
    "verification_status": {
      "$ref": "#/$defs/AttestationRecordStatus",
      "default": "blocked"
    }
  },
  "required": [
    "attestation_id",
    "authority_id",
    "issued_at",
    "not_after"
  ],
  "title": "HoldoutCustodyAttestation",
  "type": "object"
}
