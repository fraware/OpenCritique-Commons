{
  "$defs": {
    "AttestationRecordStatus": {
      "description": "Issuer-declared status of the attestation payload (not crypto verify).",
      "enum": [
        "blocked",
        "pending",
        "attested"
      ],
      "title": "AttestationRecordStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Minimal holdout custody attestation (full custody model in PR 43).",
  "properties": {
    "attestation_id": {
      "minLength": 1,
      "title": "Attestation Id",
      "type": "string"
    },
    "attestation_kind": {
      "const": "holdout_custody",
      "default": "holdout_custody",
      "title": "Attestation Kind",
      "type": "string"
    },
    "authority_id": {
      "minLength": 1,
      "title": "Authority Id",
      "type": "string"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason"
    },
    "custodian_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Custodian Id"
    },
    "freeze_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freeze Time"
    },
    "holdout_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holdout Id"
    },
    "holdout_manifest_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holdout Manifest Hash"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "natural_case_count": {
      "default": 0,
      "minimum": 0,
      "title": "Natural Case Count",
      "type": "integer"
    },
    "not_after": {
      "format": "date-time",
      "title": "Not After",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "predecessor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Id"
    },
    "subject_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Named subject digests (sha256 hex) bound by this attestation.",
      "title": "Subject Hashes",
      "type": "object"
    },
    "verification_status": {
      "$ref": "#/$defs/AttestationRecordStatus",
      "default": "blocked"
    }
  },
  "required": [
    "attestation_id",
    "authority_id",
    "issued_at",
    "not_after"
  ],
  "title": "HoldoutCustodyAttestation",
  "type": "object"
}
