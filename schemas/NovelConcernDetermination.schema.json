{
  "$defs": {
    "NovelDeterminationOutcome": {
      "description": "Immutable novel-concern determination outcomes (issue #2).",
      "enum": [
        "confirmed",
        "qualified",
        "rejected",
        "unresolved"
      ],
      "title": "NovelDeterminationOutcome",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "moderate",
        "minor",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Append-only determination record for a novel-concern candidate.",
  "properties": {
    "benchmark_id": {
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Snapshot Hash",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "case_version": {
      "title": "Case Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_ids": {
      "items": {
        "type": "string"
      },
      "title": "Decision Ids",
      "type": "array"
    },
    "determination_id": {
      "title": "Determination Id",
      "type": "string"
    },
    "finalized": {
      "default": false,
      "title": "Finalized",
      "type": "boolean"
    },
    "matcher_config_id": {
      "title": "Matcher Config Id",
      "type": "string"
    },
    "matcher_version": {
      "title": "Matcher Version",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/NovelDeterminationOutcome"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "predecessor_scorecard_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Scorecard Hash"
    },
    "predecessor_scorecard_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Scorecard Id"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "recompute_scorecard_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recompute Scorecard Hash"
    },
    "recompute_scorecard_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recompute Scorecard Id"
    },
    "requires_tie_break": {
      "default": false,
      "title": "Requires Tie Break",
      "type": "boolean"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "schema_id": {
      "default": "opencritique.NovelConcernDetermination",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scoring Policy Version"
    },
    "severity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Severity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Result Hash",
      "type": "string"
    },
    "source_submission_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Submission Hash",
      "type": "string"
    },
    "submission_id": {
      "title": "Submission Id",
      "type": "string"
    },
    "successor_benchmark_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Successor Benchmark Version"
    },
    "successor_case_set_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Successor Case Set Hash"
    }
  },
  "required": [
    "determination_id",
    "candidate_id",
    "result_id",
    "submission_id",
    "case_id",
    "case_version",
    "outcome",
    "policy_version",
    "rationale",
    "candidate_snapshot_hash",
    "source_result_hash",
    "source_submission_hash",
    "matcher_version",
    "matcher_config_id",
    "benchmark_id",
    "benchmark_version"
  ],
  "title": "NovelConcernDetermination",
  "type": "object"
}
