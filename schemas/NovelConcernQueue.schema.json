{
  "$defs": {
    "AnchorResolution": {
      "additionalProperties": false,
      "properties": {
        "reference_anchor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Reference Anchor Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/AnchorResolutionStatus"
        },
        "submitted_index": {
          "title": "Submitted Index",
          "type": "integer"
        }
      },
      "required": [
        "submitted_index",
        "status"
      ],
      "title": "AnchorResolution",
      "type": "object"
    },
    "AnchorResolutionStatus": {
      "enum": [
        "exact",
        "normalized",
        "object_label",
        "page_only",
        "ambiguous",
        "unresolved"
      ],
      "title": "AnchorResolutionStatus",
      "type": "string"
    },
    "NovelCandidateState": {
      "enum": [
        "pending_expert_adjudication",
        "accepted_novel",
        "matched_existing",
        "rejected",
        "withdrawn",
        "qualified",
        "unresolved"
      ],
      "title": "NovelCandidateState",
      "type": "string"
    },
    "NovelConcernCandidate": {
      "additionalProperties": false,
      "properties": {
        "anchor_resolutions": {
          "items": {
            "$ref": "#/$defs/AnchorResolution"
          },
          "title": "Anchor Resolutions",
          "type": "array"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "case_version": {
          "title": "Case Version",
          "type": "string"
        },
        "concern": {
          "$ref": "#/$defs/SubmittedConcern"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "result_id": {
          "title": "Result Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/NovelCandidateState",
          "default": "pending_expert_adjudication"
        },
        "submission_id": {
          "title": "Submission Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "result_id",
        "submission_id",
        "case_id",
        "case_version",
        "concern",
        "anchor_resolutions"
      ],
      "title": "NovelConcernCandidate",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "moderate",
        "minor",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SubmittedAnchor": {
      "additionalProperties": false,
      "properties": {
        "object_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Label"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        }
      },
      "title": "SubmittedAnchor",
      "type": "object"
    },
    "SubmittedConcern": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/SubmittedAnchor"
          },
          "minItems": 1,
          "title": "Anchors",
          "type": "array"
        },
        "concern_type": {
          "minLength": 3,
          "title": "Concern Type",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_summary": {
          "default": "",
          "title": "Evidence Summary",
          "type": "string"
        },
        "local_id": {
          "title": "Local Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "summary": {
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "local_id",
        "title",
        "summary",
        "concern_type",
        "severity",
        "confidence",
        "anchors"
      ],
      "title": "SubmittedConcern",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/NovelConcernCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "queue_version": {
      "default": "0.1",
      "title": "Queue Version",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "source_result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Result Hash",
      "type": "string"
    },
    "source_submission_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Submission Hash",
      "type": "string"
    },
    "submission_id": {
      "title": "Submission Id",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "submission_id",
    "candidates",
    "source_result_hash",
    "source_submission_hash"
  ],
  "title": "NovelConcernQueue",
  "type": "object"
}
