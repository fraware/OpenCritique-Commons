{
  "$defs": {
    "AuthorizedMetric": {
      "additionalProperties": false,
      "description": "Per-metric authorization entry inside a claim-authorization decision.",
      "properties": {
        "completeness_requirement": {
          "$ref": "#/$defs/CompletenessRequirement"
        },
        "denominator_policy": {
          "default": "",
          "title": "Denominator Policy",
          "type": "string"
        },
        "domain_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Scope"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metric_id": {
          "$ref": "#/$defs/ClaimMetricId"
        },
        "status": {
          "$ref": "#/$defs/MetricAuthStatus"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "system_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Version"
        }
      },
      "required": [
        "metric_id",
        "status",
        "completeness_requirement"
      ],
      "title": "AuthorizedMetric",
      "type": "object"
    },
    "ClaimMetricId": {
      "description": "Claimable scientific / operational metric identifiers.",
      "enum": [
        "anchor_integrity",
        "seeded_defect_recall",
        "reference_recall",
        "critical_precision",
        "major_precision",
        "calibration",
        "false_critical_rate",
        "cost",
        "latency"
      ],
      "title": "ClaimMetricId",
      "type": "string"
    },
    "ClaimScope": {
      "description": "Signed authorization scope for scientific performance language.",
      "enum": [
        "none",
        "private_method_report",
        "public_domain_bounded",
        "public_comparative"
      ],
      "title": "ClaimScope",
      "type": "string"
    },
    "CompletenessRequirement": {
      "description": "Minimum reference-completeness class required to publish a metric.",
      "enum": [
        "any",
        "complete_seeded",
        "adjudicated_output_complete",
        "partial_natural",
        "discovery_open"
      ],
      "title": "CompletenessRequirement",
      "type": "string"
    },
    "MetricAuthStatus": {
      "enum": [
        "authorized",
        "withheld",
        "not_applicable"
      ],
      "title": "MetricAuthStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Structured claim authorization; prefer ``claim_scope`` over the bool.\n\nPublic scopes are a derived view of a successfully verified\n``SignedClaimAuthorizationEnvelope``. Digest strings alone do not authorize.\nHeadlines and the transitional ``performance_claim_authorized`` flag derive\nfrom whether any scientific metric family is effectively authorized.",
  "properties": {
    "authorization_verified": {
      "default": false,
      "title": "Authorization Verified",
      "type": "boolean"
    },
    "authorized_metrics": {
      "items": {
        "$ref": "#/$defs/AuthorizedMetric"
      },
      "title": "Authorized Metrics",
      "type": "array"
    },
    "claim_scope": {
      "$ref": "#/$defs/ClaimScope"
    },
    "domain_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain Scope"
    },
    "expert_natural_evidence": {
      "default": false,
      "title": "Expert Natural Evidence",
      "type": "boolean"
    },
    "frozen_scoring_policy": {
      "default": false,
      "title": "Frozen Scoring Policy",
      "type": "boolean"
    },
    "independent_evaluation": {
      "default": false,
      "title": "Independent Evaluation",
      "type": "boolean"
    },
    "matcher_audit_complete": {
      "default": false,
      "title": "Matcher Audit Complete",
      "type": "boolean"
    },
    "protected_holdout": {
      "default": false,
      "title": "Protected Holdout",
      "type": "boolean"
    },
    "rights_cleared_cases": {
      "default": false,
      "title": "Rights Cleared Cases",
      "type": "boolean"
    },
    "signed_authorization_manifest_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signed Authorization Manifest Digest"
    },
    "signed_authorization_manifest_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signed Authorization Manifest Path"
    },
    "use_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Use Scope"
    },
    "verification_report_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Report Digest"
    }
  },
  "required": [
    "claim_scope"
  ],
  "title": "ClaimAuthorization",
  "type": "object"
}
