{
  "$defs": {
    "ClaimScope": {
      "description": "Signed authorization scope for scientific performance language.",
      "enum": [
        "none",
        "private_method_report",
        "public_domain_bounded",
        "public_comparative"
      ],
      "title": "ClaimScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Structured claim authorization; prefer ``claim_scope`` over the bool.",
  "properties": {
    "claim_scope": {
      "$ref": "#/$defs/ClaimScope"
    },
    "domain_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain Scope"
    },
    "expert_natural_evidence": {
      "default": false,
      "title": "Expert Natural Evidence",
      "type": "boolean"
    },
    "frozen_scoring_policy": {
      "default": false,
      "title": "Frozen Scoring Policy",
      "type": "boolean"
    },
    "independent_evaluation": {
      "default": false,
      "title": "Independent Evaluation",
      "type": "boolean"
    },
    "matcher_audit_complete": {
      "default": false,
      "title": "Matcher Audit Complete",
      "type": "boolean"
    },
    "protected_holdout": {
      "default": false,
      "title": "Protected Holdout",
      "type": "boolean"
    },
    "rights_cleared_cases": {
      "default": false,
      "title": "Rights Cleared Cases",
      "type": "boolean"
    },
    "signed_authorization_manifest_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signed Authorization Manifest Digest"
    },
    "signed_authorization_manifest_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signed Authorization Manifest Path"
    },
    "use_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Use Scope"
    }
  },
  "required": [
    "claim_scope"
  ],
  "title": "ClaimAuthorization",
  "type": "object"
}
