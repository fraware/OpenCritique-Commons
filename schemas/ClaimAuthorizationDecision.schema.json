{
  "$defs": {
    "AuthorizedMetric": {
      "additionalProperties": false,
      "description": "Per-metric authorization entry inside a claim-authorization decision.",
      "properties": {
        "completeness_requirement": {
          "$ref": "#/$defs/CompletenessRequirement"
        },
        "denominator_policy": {
          "default": "",
          "title": "Denominator Policy",
          "type": "string"
        },
        "domain_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Scope"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metric_id": {
          "$ref": "#/$defs/ClaimMetricId"
        },
        "status": {
          "$ref": "#/$defs/MetricAuthStatus"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "system_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Version"
        }
      },
      "required": [
        "metric_id",
        "status",
        "completeness_requirement"
      ],
      "title": "AuthorizedMetric",
      "type": "object"
    },
    "ClaimMetricId": {
      "description": "Claimable scientific / operational metric identifiers.",
      "enum": [
        "anchor_integrity",
        "seeded_defect_recall",
        "reference_recall",
        "critical_precision",
        "major_precision",
        "calibration",
        "false_critical_rate",
        "cost",
        "latency"
      ],
      "title": "ClaimMetricId",
      "type": "string"
    },
    "ClaimScope": {
      "description": "Signed authorization scope for scientific performance language.",
      "enum": [
        "none",
        "private_method_report",
        "public_domain_bounded",
        "public_comparative"
      ],
      "title": "ClaimScope",
      "type": "string"
    },
    "CompletenessRequirement": {
      "description": "Minimum reference-completeness class required to publish a metric.",
      "enum": [
        "any",
        "complete_seeded",
        "adjudicated_output_complete",
        "partial_natural",
        "discovery_open"
      ],
      "title": "CompletenessRequirement",
      "type": "string"
    },
    "MetricAuthStatus": {
      "enum": [
        "authorized",
        "withheld",
        "not_applicable"
      ],
      "title": "MetricAuthStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable claim-authorization decision payload (signed inside an envelope).",
  "properties": {
    "authority_id": {
      "minLength": 1,
      "title": "Authority Id",
      "type": "string"
    },
    "authorized_metrics": {
      "items": {
        "$ref": "#/$defs/AuthorizedMetric"
      },
      "title": "Authorized Metrics",
      "type": "array"
    },
    "benchmark_id": {
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Benchmark Manifest Hash",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "case_set_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Set Hash",
      "type": "string"
    },
    "claim_scope": {
      "$ref": "#/$defs/ClaimScope"
    },
    "domain_scope": {
      "minLength": 1,
      "title": "Domain Scope",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "matcher_config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Matcher Config Hash",
      "type": "string"
    },
    "matcher_version": {
      "title": "Matcher Version",
      "type": "string"
    },
    "not_after": {
      "format": "date-time",
      "title": "Not After",
      "type": "string"
    },
    "predecessor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Id"
    },
    "scoring_policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scoring Policy Hash",
      "type": "string"
    },
    "use_scope": {
      "minLength": 1,
      "title": "Use Scope",
      "type": "string"
    }
  },
  "required": [
    "claim_scope",
    "benchmark_id",
    "benchmark_version",
    "case_set_hash",
    "benchmark_manifest_hash",
    "scoring_policy_hash",
    "matcher_version",
    "matcher_config_hash",
    "domain_scope",
    "use_scope",
    "issued_at",
    "not_after",
    "authority_id"
  ],
  "title": "ClaimAuthorizationDecision",
  "type": "object"
}
